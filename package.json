{
  "name": "shared-supabase-auth",
  "version": "1.2.0",
  "description": "Shared Supabase aal2 auth gate (readAal, requireVerifiedUser, createAuthProxy) and login/MFA flow (useAuthFlow) for the Next.js personal apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.10.0",
    "@supabase/supabase-js": ">=2.45.0",
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18"
  },
  "license": "UNLICENSED",
  "private": true
}
